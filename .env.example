# Server-only AI provider configuration.
# Copy this file to .env.local and fill in real values there.
# Never commit .env.local or a real API key.

# Required when enabling AI-assisted answers.
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Optional. Defaults to https://api.openai.com/v1
# HTTPS is required, except for localhost/127.0.0.1 test servers.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# Optional. Clamped to 5000-45000 milliseconds. Defaults to 20000.
AI_PROVIDER_TIMEOUT_MS=20000
